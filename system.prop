# Audio
# ro.vendor.audio.sdk.fluencetype dan persist.vendor.audio.fluence.voicerec
# dibuang dari sini: keduanya juga diset di device.mk (baris 172 dan 174)
# dengan nilai berbeda, dan post_process_props di Android 12 menolak itu.
# Nilai device.mk yang dipertahankan karena memang itu yang selama ini
# berlaku — ADDITIONAL_SYSTEM_PROPERTIES ditulis setelah system.prop.
persist.vendor.audio.fluence.voicecall=true
persist.vendor.audio.fluence.speaker=false

# Camera
persist.camera.cpp.duplication=false
persist.camera.hal.debug.mask=0
persist.camera.disable.spzoom=1
persist.camera.disable.anight=1

# Charger
ro.charger.enable_suspend=true
ro.charger.disable_init_blank=true

#Display
# Kedua offset vsync dibuang dari sini dengan alasan yang sama: device.mk
# baris 69-70 menyetelnya ke 5000000/7500000, dan itu nilai yang berlaku.

# LMKD
ro.lmk.critical_upgrade=true
ro.lmk.downgrade_pressure=60
ro.lmk.kill_heaviest_task=false
ro.lmk.log_stats=true
ro.lmk.upgrade_pressure=40
ro.lmk.use_psi=false

# Radio
persist.radio.multisim.config=dsds
ro.config.always_show_roaming=true
vendor.rild.libpath=/system/vendor/lib/libril-qc-qmi-1.so
ril.ecclist=911,999,112,000,08,118,119,100,101,102
ril.ecclist1=911,999,112,000,08,118,119,100,101,102
ro.telephony.default_network=9,1
vendor.ril.subscription.types=NV,RUIM
telephony.lteOnCdmaDevice=1

# Screen density
ro.sf.lcd_density=280

# Volte
persist.dbg.ims_volte_enable=1
persist.dbg.volte_avail_ovr=1 

persist.hwc.ptor.enable=true
persist.hwc.pubypass=true
