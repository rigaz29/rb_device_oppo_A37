// Android 17 membuang android.hardware.light@2.0 (HIDL) dari
// hardware/interfaces; yang tersisa hanya aidl/ dan utils/. HAL ini karena itu
// dipindah ke AIDL ILights V2, dengan logika sysfs dipertahankan PERSIS --
// termasuk kedip gaya QCOM lewat grpfreq/grppwm, yang tidak direproduksi HAL
// generik android.hardware.light-service.lineage (ia memakai node tunggal
// /sys/class/leds/rgb/rgb_blink).

cc_binary {
    name: "android.hardware.light-service.oppo_msm8916",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.light-service.oppo_msm8916.rc"],
    vintf_fragments: ["android.hardware.light-service.oppo_msm8916.xml"],
    srcs: [
        "Lights.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.light-V2-ndk",
    ],
}
