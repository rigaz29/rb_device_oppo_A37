// Blob vendor msm8916 menaut "libstdc++.so" lewat DT_NEEDED (158 berkas,
// termasuk camera.vendor.msm8916.so), dan tanpa salinan di /vendor/lib daemon
// kamera gagal link:
//   CANNOT LINK EXECUTABLE "/system/vendor/bin/mm-qcamera-daemon":
//   library "libstdc++.so" not found
//
// Modul libstdc++_vendor (bionic/libc/Android.bp:1818) memasang berkasnya
// sebagai /vendor/lib/libstdc++_vendor.so -- nama yang tidak dicari linker.
//
// Menambahkan stem: "libstdc++" pada modul itu SUDAH DICOBA dan menggagalkan
// build: varian ramdisk-nya lalu bertabrakan dengan libstdc++ platform --
//   ninja: multiple rules generate .../symbols/ramdisk/system/lib/libstdc++.so
// Karena itu dipakai symlink, bukan penggantian nama.
install_symlink {
    name: "libstdc++_vendor_symlink",
    soc_specific: true,
    installed_location: "lib/libstdc++.so",
    symlink_target: "libstdc++_vendor.so",
}

// libandroid.so dan libmedia.so untuk namespace vendor.
//
// Keduanya dibangun di libshims/ sebagai libandroid_a37_vendor.so dan
// libmedia_a37_vendor.so, karena LOCAL_MODULE_STEM ditolak untuk pustaka
// (shared_library_internal.mk:17) dan memakai nama aslinya akan bentrok dengan
// modul platform. Symlink di bawah memberi nama yang benar-benar dicari linker.
//
// libandroid: blob kamera menaut lewat DT_NEEDED dan butuh 13 simbol.
//   CANNOT LINK EXECUTABLE "/vendor/bin/mm-qcamera-daemon":
//   library "libandroid.so" not found:
//   needed by /system/vendor/lib/libmmcamera2_stats_modules.so
//
// libmedia: libril-qc-qmi-1.so menautnya tapi memakai NOL simbolnya.
//   RILD: dlopen failed: library "libmedia.so" not found:
//         needed by /system/vendor/lib/libril-qc-qmi-1.so
install_symlink {
    name: "libandroid_a37_vendor_symlink",
    soc_specific: true,
    installed_location: "lib/libandroid.so",
    symlink_target: "libandroid_a37_vendor.so",
}

install_symlink {
    name: "libmedia_a37_vendor_symlink",
    soc_specific: true,
    installed_location: "lib/libmedia.so",
    symlink_target: "libmedia_a37_vendor.so",
}

// libgui.so untuk namespace vendor.
//
// Berbeda dari libandroid/libmedia, libgui PUNYA varian vendor resmi di AOSP:
// libgui_vendor (frameworks/native/libs/gui/Android.bp:581, vendor: true,
// defaults libgui_defaults) -- pustaka libgui sungguhan, bukan stub. Karena itu
// tidak dibuatkan shim; cukup dipasang lalu diberi nama yang dicari linker.
//
// Dipakai juga oleh acroreiser/ULH a6010 (camera/hal3on1/Android.mk:22) dan
// Mi-Thorium (libshim/Android.bp:58).
//
//   CANNOT LINK EXECUTABLE "/system/vendor/bin/mm-qcamera-daemon":
//   library "libgui.so" not found:
//   needed by /system/vendor/lib/libmmcamera2_stats_modules.so
install_symlink {
    name: "libgui_vendor_symlink",
    soc_specific: true,
    installed_location: "lib/libgui.so",
    symlink_target: "libgui_vendor.so",
}

// libcamera_client.so untuk namespace vendor/sphal.
//
// Isinya HANYA CameraParameters -- diukur dari blob: 137 dari 372 simbol UND-nya
// diambil dari libcamera_client, dan seluruh 137 itu CameraParameters.
// Lihat komentar lengkap di libshims/Android.mk.
install_symlink {
    name: "libcamera_client_a37_vendor_symlink",
    soc_specific: true,
    installed_location: "lib/libcamera_client.so",
    symlink_target: "libcamera_client_a37_vendor.so",
}
