<?xml version="2.0" encoding="UTF-8"?>
<!--
     Framework compatibility matrix khusus A37 — DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE.

     Dijalankan ke device manifest oleh check_vintf_compatible (check-vintf-all) dan
     menolak HAL yang ada di device manifest tapi tidak dideklarasikan di matrix mana
     pun. Error aslinya (10 instance):

       The following instances are in the device manifest but not specified in
       framework compatibility matrix: ... (liat log check_vintf_compatible.log)

     Semua instance di bawah ini legacy/vendor — TIDAK akan masuk matrix hulu, jadi
     dideklarasikan di sini sebagai optional, persis yang disarankan pesan errornya:

       "For device-specific HALs, add to DEVICE_FRAMEWORK_COMPATIBILITY_MATRIX_FILE"

     Beberapa yang SEMPAT masuk daftar "not declared in FCM <= level 5" TAPI TIDAK
     ditolak checkvintf, dan karena itu TIDAK dideklarasikan di sini:
       - android.hardware.cas, android.hardware.drm@1.4, android.hardware.wifi@1.6,
         android.hardware.wifi.hostapd, android.hardware.wifi.supplicant
       Mereka ada di matrix FCM level > 5 (6/7/8), dan check menerimanya karena
       target-level device cuma menuntut minimum — bukan larangan.
-->
<compatibility-matrix version="2.0" type="framework">
    <!-- Cameraservice HIDL 2.1 — HAL tidak ada di matrix hulu mana pun;
         CameraService.cpp:174 mendaftarkannya langsung dari system image. -->
    <hal format="hidl" optional="true">
        <name>android.frameworks.cameraservice.service</name>
        <version>2.1</version>
        <interface>
            <name>ICameraService</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- configstore 1.1 — digantikan sysprop di A14, tapi HAL lama masih
         dipakai SurfaceFlinger msm8916 (passthrough, vendor image). -->
    <hal format="hidl" optional="true">
        <name>android.hardware.configstore</name>
        <version>1.1</version>
        <interface>
            <name>ISurfaceFlingerConfigs</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- light 2.0 — kernel 3.10, HAL lama. -->
    <hal format="hidl" optional="true">
        <name>android.hardware.light</name>
        <version>2.0</version>
        <interface>
            <name>ILight</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- power 1.0 — HIDL lama, belum dimigrasi ke AIDL (PLAN.md §4.3). -->
    <hal format="hidl" optional="true">
        <name>android.hardware.power</name>
        <version>1.0</version>
        <interface>
            <name>IPower</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- radio.deprecated 1.0 IOemHook — didaftarkan rild dari dalam prosesnya. -->
    <hal format="hidl" optional="true">
        <name>android.hardware.radio.deprecated</name>
        <version>1.0</version>
        <interface>
            <name>IOemHook</name>
            <instance>slot1</instance>
            <instance>slot2</instance>
        </interface>
    </hal>
    <!-- vibrator 1.0 — passthrough lama. -->
    <hal format="hidl" optional="true">
        <name>android.hardware.vibrator</name>
        <version>1.0</version>
        <interface>
            <name>IVibrator</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- vendor.lineage.health IChargingControl (AIDL) — fragment health-service
         bawaan LineageOS; padanannya di vendor/lineage/config/device_framework_matrix.xml
         TIDAK dipakai build ini (tidak ada yang mereferensikan berkas itu). -->
    <hal format="aidl" optional="true">
        <name>vendor.lineage.health</name>
        <interface>
            <name>IChargingControl</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- livedisplay 2.0 IDisplayColorCalibration — hanya interface yang TERBUKTI
         akan register yang didaftarkan (lihat catatan manifest.xml). -->
    <hal format="hidl" optional="true">
        <name>vendor.lineage.livedisplay</name>
        <version>2.0</version>
        <interface>
            <name>IDisplayColorCalibration</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- vendor.qti.hardware.perf — HAL QTI lama, hwbinder. -->
    <hal format="hidl" optional="true">
        <name>vendor.qti.hardware.perf</name>
        <version>1.0</version>
        <interface>
            <name>IPerf</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
