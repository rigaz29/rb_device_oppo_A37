        <transport>hwbinder</transport>
        <!-- HARUS 1.1, bukan 1.0. libril mendaftarkan RadioImpl sebagai
             android.hardware.radio@1.1::IRadio (ril_service.cpp:130 —
             "struct RadioImpl : public V1_1::IRadio"), dan
             registerAsServiceInternal() menolak mendaftar bila transport HAL
             tidak HWBINDER menurut manifest (ServiceManagement.cpp:838-847).
             getHidlTransport() mencocokkan versi dengan minorAtLeast(), jadi
             deklarasi 1.0 TIDAK memenuhi permintaan 1.1 -> transport EMPTY ->
             pendaftaran gagal diam-diam, rild tetap hidup tapi IRadio tidak
             pernah muncul di hwservicemanager, dan com.android.phone
             menggantung di IRadio.getService() sampai kena ANR. -->
        <version>1.1</version>
        <interface>
            <name>IRadio</name>
            <instance>slot1</instance>
            <instance>slot2</instance>
        </interface>
        <interface>
            <name>ISap</name>
            <instance>slot1</instance>
            <instance>slot2</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.radio.deprecated</name>
        <!-- hwbinder, BUKAN passthrough: OemHookImpl didaftarkan lewat
             registerAsService() dari dalam rild (ril_service.cpp:8733-8737),
             jadi ini HAL binderized. Deklarasi passthrough membuat
             registerAsServiceInternal() menolaknya dengan alasan yang sama
             seperti IRadio di atas. ROM referensi juga hwbinder. -->
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IOemHook</name>
            <instance>slot1</instance>
            <instance>slot2</instance>
        </interface>
    </hal>
    <hal format="hidl">
        <name>android.hardware.renderscript</name>
        <transport arch="32+64">passthrough</transport>
        <version>1.0</version>
        <!-- Tanpa blok <interface> ini deklarasi HAL-nya tidak berarti apa-apa:
             getHidlTransport() mencari per-instance, jadi IDevice/default tetap
             EMPTY dan libRS tidak bisa memuat impl passthrough-nya. -->
        <interface>
            <name>IDevice</name>
            <instance>default</instance>
        </interface>
    </hal>
    <!-- health: dihapus — paket health@2.1-service bawa VINTF fragment sendiri.
         Sumber: msm8916-common lineage-18.1 -->
    <!-- usb: DIPERTAHANKAN — cyanogen_8916 tidak punya VINTF fragment,
