    <!-- vendor.qti.hardware.iop: DIBUANG DI LOS 20 — koreksi terhadap 19.1.
         Di 19.1 deklarasi ini hanya berjalan karena dummy android.hidl.base@1.0
         dipasang ke /system/lib. LOS 20 menyediakan hidl.base lewat
         hardware/lineage/compat yang masuk system_ext/lib, dan namespace
         linker vendor TIDAK menjangkau system_ext (linkerconfig
         contents/namespace/vendordefault.cc) — jadi impl passthrough iop
         tidak mungkin dimuat lagi. Tidak ada konsumennya di build ini (nol
         blob lain mereferensikan iop; ROM gt58wifi yang boot juga tidak
         mengirimnya). Sesuai aturan 10.C: jangan deklarasikan yang tak
         mungkin register. Blob-nya tetap terpasang (dorman, nol efek
         runtime). -->
    <hal format="hidl">
        <name>android.hardware.drm</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <!-- instance "widevine" dibuang bersama blob-nya: kedua
             android.hardware.drm@1.x-service.widevine gagal link karena
             libwvhidl.so butuh protobuf lama. Lihat catatan di
             proprietary-files.txt. Deklarasi tanpa implementasi bikin klien
             MediaDrm menunggu getService() sia-sia. -->
        <!-- instance "clearkey" DIBUANG (TODO Fase 3 di device.mk:158, akhirnya
             dikerjakan). Alasannya persis sama dengan widevine di atas:
             deklarasi tanpa implementasi membuat klien menunggu sia-sia.

             Android 15 mengirim clearkey sebagai servis AIDL
             (android.hardware.drm-service.clearkey, terdaftar sebagai
             android.hardware.drm.IDrmFactory/clearkey), BUKAN HIDL. Yang
             tersedia lewat HIDL di perangkat ini hanya instance "default".

             Gejalanya terukur: com.android.rkpdapp meminta
             @1.0::IDrmFactory/clearkey, hwservicemanager mencoba menyalakannya
             sebagai lazy HAL, gagal dengan PROP_ERROR_HANDLE_CONTROL_MESSAGE,
             lalu klien menunggu satu detik, berulang 1 kali per detik tanpa
             henti. Setelah banjir RILJ diperbaiki, sisa ini menjadi 65 dari 99
             baris log.

             DRM clearkey tetap berfungsi lewat AIDL; yang dibuang hanya
             deklarasi HIDL yang tidak pernah ada implementasinya. -->
        <interface>
            <name>ICryptoFactory</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IDrmFactory</name>
            <instance>default</instance>
        </interface>
    </hal>
