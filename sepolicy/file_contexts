# Dua label sensord/accelcal DIBUANG di LOS 22.
#
# A37 TIDAK mengirim /system/bin/sensord maupun /system/bin/accelcal --
# nol entri di proprietary-files. Labelnya warisan basis lama.
#
# Membiarkannya menggagalkan sepolicy_test A15 dengan DUA keluhan:
#   ('sensors_exec', '/system/bin/sensord') harus punya system_file_type
#   The following domain is system and vendor: sensors
# Keluhan kedua muncul karena domain sensors adalah domain VENDOR, tapi
# binernya dilabeli di /system -- kontradiksi yang tidak bisa diperbaiki
# dengan menambah atribut, hanya dengan membuang label matinya.
/data/misc/sensor(/.*)?                    u:object_r:sensors_data_file:s0
/data/cam_socket(.*)?   			   u:object_r:camera_socket:s0
/sys/devices/soc.0/1c00000\.qcom,kgsl-3d0/kgsl/kgsl-3d0/gpuclk        u:object_r:sysfs:s0
/dev/smdcntl0				   u:object_r:smd_device:s0
# Lights
# Sebelumnya baris ini menunjuk ...-service.a6000 (sisa kang dari Lenovo
# a6000). Biner yang benar-benar dibangun device ini adalah
# android.hardware.light@2.0-service.oppo_msm8916 (lihat lights/Android.bp),
# jadi biner aslinya tidak pernah dapat label dan init tidak bisa transisi ke
# domain hal_light_default.
/(system/vendor|vendor)/bin/hw/android\.hardware\.light@2\.0-service\.oppo_msm8916    u:object_r:hal_light_default_exec:s0
# HAL vibrator AIDL yang menggantikan jalur HIDL 1.0 (dihapus hulu di 23.2).
# Domain hal_vibrator_default sudah ada di system/sepolicy/vendor/
# hal_vibrator_default.te; yang kurang hanya label untuk biner bernama msm8916.
# Baris ini disalin dari a6010 (sepolicy/vendor/file_contexts:63).
/(system/vendor|vendor)/bin/hw/android\.hardware\.vibrator-service\.msm8916    u:object_r:hal_vibrator_default_exec:s0
/sys/class/leds/lcd-backlight(/.*)? 	   u:object_r:sysfs_leds:s0
/dev/block/platform/soc.0/7824900.sdhci/by-name/persist    u:object_r:persist_block_device:s0

# HALs
/system/vendor/bin/hw/android\.hardware\.usb@1\.0-service\.cyanogen_8916       u:object_r:hal_usb_default_exec:s0
# gatekeeper software variant — AOSP vendor/file_contexts hanya punya
# pola android.hardware.gatekeeper@1.0-service (tanpa .software)
/(system/vendor|vendor)/bin/hw/android\.hardware\.gatekeeper@1\.0-service\.software    u:object_r:hal_gatekeeper_default_exec:s0

# DRM clearkey — device.mk memasang android.hardware.drm@1.3-service.clearkey,
# tapi AOSP system/sepolicy/vendor/file_contexts:25-26 hanya melabeli
# drm@1.0-service dan drm@1.0-service-lazy, dan .rc bawaannya
# (frameworks/av/drm/mediadrm/plugins/clearkey/hidl/*.rc) tidak menyetel
# seclabel. Tanpa entri ini binernya berlabel vendor_file, init gagal
# transisi domain, dan servisnya jalan di domain init.
/(system/vendor|vendor)/bin/hw/android\.hardware\.drm@1\.3-service\.clearkey    u:object_r:hal_drm_default_exec:s0

# TimeKeep
/sys/devices/soc\.0/qpnp-rtc-[0-9]/rtc/rtc0(/.*)?                         u:object_r:sysfs_rtc:s0
/(system/vendor|vendor)/bin/timekeep                                      u:object_r:timekeep_exec:s0

# gralloc adalah same-process HAL: ia di-dlopen KE DALAM proses siapa pun yang
# menggambar, bukan diakses lewat servis binder seperti hwcomposer atau memtrack.
# Karena itu labelnya harus same_process_hal_file, bukan vendor_file bawaan.
#
# Tanpa entri ini terukur 25 denial dalam satu sesi aktivitas singkat, dari
# system_server, surfaceflinger, platform_app, system_app, dan untrusted_app --
# semuanya getattr/read/open pada berkas yang sama. Sekarang tidak terlihat
# akibatnya karena SELinux berjalan permissive; kalau suatu saat dipindah ke
# enforcing, grafis akan patah.
#
# Pola ini sudah dipakai sepolicy QCOM hulu untuk platform sejenis:
#   device/qcom/sepolicy-legacy-um/legacy/vendor/msm8996/file_contexts:105
#   device/qcom/sepolicy-legacy-um/legacy/vendor/msm8937/file_contexts:61
/(system/vendor|vendor)/lib(64)?/hw/gralloc\.msm8916\.so    u:object_r:same_process_hal_file:s0

# libmemalloc adalah dependensi langsung gralloc.msm8916.so (DT_NEEDED), jadi ia
# ikut termuat ke dalam proses aplikasi mana pun yang menggambar. Setelah gralloc
# dilabeli same_process_hal_file, denial-nya hanya turun satu tingkat ke sini:
#   avc: denied { read } name="libmemalloc.so" scontext=u:r:untrusted_app
#        tcontext=u:object_r:vendor_file:s0 app=org.lineageos.aperture
# Dua dependensi vendor gralloc yang lain, libqdutils.so dan libqdMetaData.so,
# sudah berlabel benar dari sepolicy QCOM hulu. libmemalloc tidak ikut terlabeli
# karena ia khas era msm8916 dan tidak ada di berkas platform hulu yang lebih baru.
/(system/vendor|vendor)/lib(64)?/libmemalloc\.so    u:object_r:same_process_hal_file:s0

# Cpuset — tanpa label ini, semua berkas di bawah /dev/cpuset (termasuk
# cpuset.cpus dan cpuset.mems di sub-cgroup yang dibuat init.qcom.power.rc)
# mendapat label default tmpfs dan init ditolak menulisnya saat boot
# (sebelum SELinux di-set permissive). Pola ini dicopy dari A6010
# (sepolicy/vendor/file_contexts:13) dan dipakai luas di sepolicy QCOM hulu.
/dev/cpuset(/.*)?    u:object_r:cgroup:s0

# Thermal HAL. AOSP hanya melabeli android.hardware.thermal@1.[01]-service dan
# thermal-service.example (system/sepolicy/vendor/file_contexts:115-116); varian
# @2.0-service.msm8916 yang dipakai perangkat ini tidak tercakup. Pola dicopy
# dari a6010 (sepolicy/vendor/file_contexts:60).
/(vendor|system/vendor)/bin/hw/android\.hardware\.thermal@2\.0-service\.msm8916    u:object_r:hal_thermal_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.camera\.provider-service\.lineage    u:object_r:hal_camera_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.radio@1\.5-service\.msm8916    u:object_r:hal_radio_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.radio\.config@1\.1-service\.msm8916    u:object_r:hal_radio_config_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.drm@1\.1-service\.widevine    u:object_r:hal_drm_default_exec:s0
