// Dikonversi dari Android.mk: BUILD_HOST_EXECUTABLE obsolete di Android 11
// (build/make/core/board_config.mk:648-652 -> KATI_obsolete_var).
//
// Varian OPPO ini TIDAK bisa diganti dtbToolLineage (system/tools/dtbtool):
// ia menambah field oppoId ke tiap entri DT sehingga entry_size jadi 28/44
// (bukan 24/40), dan bootloader OPPO memakai field itu untuk memilih DT.
//
// Guard "ifeq ($(BOARD_KERNEL_SEPARATED_DT),true)" dari Android.mk lama tidak
// dibawa: Soong tidak punya kondisional seperti itu. Tidak masalah karena
// dt_image.mk baru mereferensikan $(DTBTOOL) ketika flag tersebut true.
cc_binary_host {
    name: "dtbToolOppo",

    srcs: ["dtbtool.c"],

    cflags: ["-Wall"],
}
