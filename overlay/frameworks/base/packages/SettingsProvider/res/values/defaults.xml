<resources>

    <!-- 60 seconds for default screen timeout -->
    <integer name="def_screen_off_timeout">60000</integer>
    <bool name="def_screen_brightness_automatic_mode">true</bool>
    <bool name="def_bluetooth_on">false</bool>
    <bool name="def_wifi_on">true</bool>

    <!-- Gesture scanning consumes more power while the panel is suspended. -->
    <bool name="def_double_tap_to_wake">false</bool>

    <!-- Animasi 0.5x: transisi terasa snappy di hardware low-end
         (Adreno 306 + 4x A53 tidak cukup untuk animasi 1x yang mulus). -->
    <fraction name="def_window_animation_scale">50%</fraction>
    <fraction name="def_window_transition_scale">50%</fraction>
</resources>
