on early-init
    #set non-stand-charger can used
    write /sys/module/phy_msm_usb/parameters/floated_charger_enable Y

on boot
    # charger
    chown system system /sys/class/power_supply/bms/capacity
    chmod 0660 /sys/class/power_supply/bms/capacity
    chown root system /sys/class/power_supply/bms/current_now
    chown root system /sys/class/power_supply/bms/voltage_ocv
    chmod 0664 /sys/class/power_supply/bms/current_now
    chmod 0664 /sys/class/power_supply/bms/voltage_ocv
    chown system system /sys/class/sensors/proximity/enable
    chmod 0660 /sys/class/sensors/proximity/enable
    chown system system /sys/class/sensors/light/enable
    chmod 0660 /sys/class/sensors/light/enable

    # zram: pakai LZ4 (2-3x lebih cepat dari LZO, kompresi ~10-20% lebih rendah).
    # lib/lz4 sudah di-backport dari kernel 3.18 (commit cc36528 di fork
    # rigaz29/kernel_oppo_msm8939, branch lz4-backport). Harus diset sebelum
    # disksize ditulis oleh swapon_all di on post-fs.
    write /sys/block/zram0/comp_algorithm lz4

service vm_bms /system/vendor/bin/vm_bms
    class main
    user root
    group root wakelock

# service imsqmidaemon / imsdatadaemon DIBUANG, berikut pemicu
# "on property:sys.ims.QMI_DAEMON_STATUS=1 -> start imsdatadaemon".
#
# Ketiga daemon IMS ber-ELF 64-bit dengan interpreter /system/bin/linker64,
# sedangkan ROM ini TARGET_ARCH := arm / armeabi-v7a dan hanya punya
# /system/bin/linker 32-bit. init mengulangnya tiap 5 detik selamanya:
#
#   E init: cannot execv('/system/vendor/bin/imsqmidaemon'). ...
#           No such file or directory
#
# ENOENT itu menunjuk interpreternya, bukan binernya — binernya ada, 120.464 B.
# Audit seluruh ROM: hanya ketiga file IMS inilah biner 64-bit yang terpasang.
#
# imsdatadaemon sebenarnya sudah "disabled" dan hanya dipicu properti yang
# di-set imsqmidaemon, jadi praktis yang berputar cuma imsqmidaemon. Keduanya
# tetap dibuang supaya tidak ada service yang menunjuk biner mati, dan pemicu
# propertinya ikut dibuang agar tidak menunjuk service yang tidak ada lagi.
#
# Library lib-ims* (15 buah, semuanya 32-bit) beserta ims.apk dan
# imscmlibrary.jar DIPERTAHANKAN: pemindaian DT_NEEDED menunjukkan mereka
# hanya saling merujuk sesama IMS, tidak ada konsumen di luar. IMS/VoLTE
# memang tidak pernah hidup sejak awal karena daemonnya tidak pernah jalan.

on post-fs
    chmod 0222 /sys/kernel/debug/tracing/trace_marker
    swapon_all /vendor/etc/fstab.qcom
    write /proc/sys/vm/page-cluster 0
    # swappiness 60: dengan LZ4 zram, swap murah — manfaatkan untuk
    # menjaga lebih banyak app di background.
    write /proc/sys/vm/swappiness 60
    write /proc/sys/vm/dirty_background_ratio 10
    write /proc/sys/vm/dirty_expire_centisecs 200
    write /proc/sys/vm/dirty_ratio 30
    write /proc/sys/vm/vfs_cache_pressure 65

on post-fs-data
    # deadline lebih cocok untuk eMMC daripada cfq (latency lebih rendah,
    # throughput lebih tinggi untuk random I/O).
    write /sys/block/mmcblk0/queue/scheduler deadline
    write /sys/block/mmcblk0/queue/add_random 0
    write /sys/block/mmcblk0/queue/nr_requests 256
    # Cukup satu baris. queue/read_ahead_kb dan bdi/read_ahead_kb menulis field
    # yang SAMA — blk-sysfs.c:116 menyetel q->backing_dev_info.ra_pages dan
    # backing-dev.c:169 menyetel bdi->ra_pages, dan untuk perangkat blok
    # keduanya backing_dev_info yang sama. Baris "queue/read_ahead_kb 512" yang
    # dulu ada di sini langsung ditimpa baris berikutnya, jadi tidak pernah
    # berlaku — dibuang supaya tidak menyesatkan.
    write /sys/block/mmcblk0/bdi/read_ahead_kb 128

on charger
   wait /dev/block/bootdevice/by-name/system
   mount ext4 /dev/block/bootdevice/by-name/system /system ro barrier=1
   chown root system /sys/class/power_supply/bms/current_now
   chown root system /sys/class/power_supply/bms/voltage_ocv
   chmod 0664 /sys/class/power_supply/bms/current_now
   chmod 0664 /sys/class/power_supply/bms/voltage_ocv
   # load_system_props dihapus: deprecated di Android 11. host_init_verifier
   # menolaknya sebagai error sehingga build gagal, dan di runtime pun ia sudah
   # no-op — do_load_system_props (system/core/init/builtins.cpp:1084) hanya
   # mencatat "deprecated action `load_system_props` called" lalu return.
   start vm_bms

on property:sys.boot_completed=1
    write /sys/module/process_reclaim/parameters/enable_process_reclaim 1
    write /sys/module/process_reclaim/parameters/pressure_max 70
    write /sys/module/process_reclaim/parameters/swap_opt_eff 30
    write /sys/module/process_reclaim/parameters/pressure_min 50
    write /sys/module/process_reclaim/parameters/per_swap_size 512
    # EMPAT baris /sys/module/lowmemorykiller/parameters/* DIBUANG dari sini:
    #   enable_adaptive_lmk 0
    #   lmk_fast_run 0
    #   vmpressure_file_min 53059
    #   minfree "12288,16384,20480,24576,28672,34816"
    #
    # Keempatnya tidak pernah berlaku. defconfig:518 berbunyi
    # "# CONFIG_ANDROID_LOW_MEMORY_KILLER is not set", dan
    # drivers/staging/android/Makefile:11 menggantungkan lowmemorykiller.o pada
    # config itu — modulnya tidak dibangun, jadi direktori sysfs-nya tidak ada.
    #
    # Yang membunuh proses di sini adalah lmkd userspace, dan ambangnya TIDAK
    # datang dari file ini melainkan dari framework:
    # ProcessList.java:827 updateOomLevels() menghitungnya dari ukuran RAM dan
    # resolusi layar, lalu mengirimkannya lewat perintah soket LMK_TARGET
    # (ProcessList.java:314-321 -> lmkd.cpp:1403).
    #
    # Untuk RAM 2 GB rumus skalanya jenuh —
    #   scaleMem = (2048 - 350) / (700 - 350) = 4,85 -> dibatasi 1,0
    # sehingga dipakai mOomMinFreeHigh sepenuhnya: 72-180 MB. Perhatikan itu
    # LEBIH agresif daripada 48-136 MB yang diniatkan baris minfree lama, jadi
    # membuang baris mati ini tidak mengubah apa pun ke arah mana pun.
    #
    # Kalau suatu saat ingin lebih banyak app bertahan di background, tuasnya
    # ro.lmk.* (lmkd.cpp:3288-3311, semuanya belum diset di device ini), bukan
    # baris-baris di atas.
    #
    # Blok process_reclaim di sekitarnya DIPERTAHANKAN — CONFIG_PROCESS_RECLAIM=y
    # ada di defconfig dan terverifikasi di .config hasil build, jadi jalur itu
    # nyata.
    write /proc/sys/vm/min_free_kbytes 4096
    write /proc/sys/vm/extra_free_kbytes 8192
    # CATATAN: tiga baris tuning KSM dibuang — CONFIG_KSM tidak menyala di
    # lineageos_a37f_defconfig, jadi /sys/kernel/mm/ksm/ tidak pernah ada.
    # Sengaja tidak dinyalakan: di Snapdragon 410 ongkos CPU untuk scanning KSM
    # tidak sepadan dengan hemat RAM-nya.
    write /sys/block/mmcblk0/queue/scheduler noop
    write /sys/block/mmcblk0/queue/rq_affinity 0
    write /sys/block/mmcblk0/queue/nr_requests 128
    # Satu baris saja — lihat catatan read_ahead_kb di blok sebelumnya.
    write /sys/block/mmcblk0/bdi/read_ahead_kb 128
