import /vendor/etc/init/hw/init.qcom.power.rc
import /vendor/etc/init/hw/init.qcom.ssr.rc
import /vendor/etc/init/hw/init.qcom.usb.rc
import /vendor/etc/init/hw/init.target.rc

on early-init
    mount debugfs debugfs /sys/kernel/debug
    chown system system /sys/kernel/debug
    chmod 0755 /sys/kernel/debug

    # Turn off backlight on blank
    write /sys/class/leds/lcd-backlight/trigger "backlight"

on fs
    wait /dev/block/platform/soc.0/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc.0/${ro.boot.bootdevice} /dev/block/bootdevice

    mount_all /vendor/etc/fstab.qcom
    restorecon_recursive /persist

    # Fase 9 (perbaikan bootloop): node charging control harus writable oleh
    # user system. health-service (user system) menunggu node yang bisa
    # diakses R_OK|W_OK di constructor ChargingControl() (loop retry 100ms);
    # sysfs power_supply dibuat 0644 root:root sehingga tanpa chmod ini
    # access(W_OK) selalu gagal -> loop selamanya -> IChargingControl tak
    # pernah register -> waitForDeclaredService di main thread system_server
    # menggantung -> Watchdog membunuh system_server -> bootloop.
    # Node ini atribut statis battery psy (qpnp-linear-charger, probe saat
    # init kernel) sehingga sudah ada sebelum on fs. 0666: perangkat uji.
    chmod 0666 /sys/class/power_supply/battery/charging_enabled

# msm specific files that need to be created on /data
on post-fs-data
    mkdir /data/fdAlbum 0770 camera camera
    mkdir /data/misc/camera 0770 camera camera

    # Create directory used by display clients
    mkdir /data/misc/display 0770 system graphics

    # Move to o-mr1 perfd dir schema
    mkdir /data/vendor/perfd 0770 root system
    chmod 2770 /data/vendor/perfd
    rm /data/vendor/perfd/default_values

    #Create IOP  deamon related dirs
    mkdir /data/vendor/iop 0700 root system

    mkdir /tombstones/modem 0771 system system
    mkdir /tombstones/lpass 0771 system system
    mkdir /tombstones/wcnss 0771 system system
    mkdir /tombstones/dsps 0771 system system

    #Create directories for Location services
    mkdir /data/misc/location 0770 gps gps
    mkdir /data/misc/location/mq 0770 gps gps
    mkdir /data/misc/location/xtwifi 0770 gps gps

    # Create the directories used by the Wireless subsystem
    mkdir /data/vendor/wifi 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

    # Create /data/time folder for time-services
    mkdir /data/time/ 0700 system system

    setprop vold.post_fs_data_done 1

on early-boot
    # set RLIMIT_MEMLOCK to 64MB
    setrlimit 8 67108864 67108864
    write /sys/kernel/boot_adsp/boot 1

on boot
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/type
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chown bluetooth bluetooth /dev/ttyHS0
    chmod 0660 /dev/ttyHS0

    # Create directory used by display clients
    mkdir /persist/alarm 0770 system system
    mkdir /persist/display 0770 system graphics

    #Create QMUX deamon socket area
    mkdir /dev/socket/qmux_radio 2770 radio radio
    mkdir /dev/socket/qmux_audio 2770 media audio
    mkdir /dev/socket/qmux_bluetooth 2770 bluetooth bluetooth
    mkdir /dev/socket/qmux_gps 2770 gps gps

    #Create NETMGR daemon socket area
    mkdir /dev/socket/netmgr 0750 radio radio

#   Assign TCP buffer thresholds to be ceiling value of technology maximums
#   Increased technology maximums should be reflected here.
    write /proc/sys/net/core/rmem_max  16777216
    write /proc/sys/net/core/wmem_max  8388608

    #To allow interfaces to get v6 address when tethering is enabled
    # To allow interfaces to get v6 address when tethering is enabled
    write /proc/sys/net/ipv6/conf/rmnet0/accept_ra 2
    write /proc/sys/net/ipv6/conf/rmnet1/accept_ra 2
    write /proc/sys/net/ipv6/conf/rmnet2/accept_ra 2
    write /proc/sys/net/ipv6/conf/rmnet3/accept_ra 2
    write /proc/sys/net/ipv6/conf/rmnet4/accept_ra 2
    write /proc/sys/net/ipv6/conf/rmnet5/accept_ra 2
    write /proc/sys/net/ipv6/conf/rmnet6/accept_ra 2
    write /proc/sys/net/ipv6/conf/rmnet7/accept_ra 2

    # To prevent out of order acknowledgements from making
    # connection tracking to treat them as not belonging to
    # the connection they belong to.
    # Otherwise, a weird issue happens in which some long
    # connections on high-throughput links get dropped when
    # an ack packet comes out of order
    write /proc/sys/net/netfilter/nf_conntrack_tcp_be_liberal 1

    # Graphics node permissions
    chown system graphics /sys/class/graphics/fb0/dyn_pu
    chmod 0664 /sys/class/graphics/fb0/dyn_pu
    chown system graphics /sys/class/graphics/fb0/dynamic_fps
    chmod 0664 /sys/class/graphics/fb0/dynamic_fps
    chown system graphics /sys/class/graphics/fb0/idle_time
    chmod 0664 /sys/class/graphics/fb0/idle_time
    chown system graphics /sys/class/graphics/fb0/mode
    chmod 0664 /sys/class/graphics/fb0/mode
    chown system graphics /sys/class/graphics/fb0/modes
    chmod 0664 /sys/class/graphics/fb0/modes

    # Wifi firmware reload path
    chown wifi wifi /sys/module/wlan/parameters/fwpath

service irsc_util /system/vendor/bin/irsc_util "/system/vendor/etc/sec_config"
    class main
    user root
    oneshot

service rmt_storage /system/vendor/bin/rmt_storage
    class core
    user root
    group wakelock
    writepid /dev/cpuset/system-background/tasks

# FM
on property:vendor.hw.fm.init=0
    write /sys/module/radio_iris_transport/parameters/fmsmd_set 0

on property:vendor.hw.fm.init=1
    write /sys/module/radio_iris_transport/parameters/fmsmd_set 1

# QMUX must be in multiple groups to support external process connections
service qmuxd /system/vendor/bin/qmuxd
    class main
    user root
    group radio audio bluetooth gps oem_2950 wakelock
    writepid /dev/cpuset/system-background/tasks

service netmgrd /system/vendor/bin/netmgrd
    class main
    group system wakelock
    writepid /dev/cpuset/system-background/tasks

# wpa_supplicant DIBUANG DI LOS 20 — koreksi Fase 10.
# Definisi HIDL ini warisan 19.1; di LOS 20 wpa_supplicant adalah servis AIDL
# dari hardware/interfaces/wifi (android.hardware.wifi.supplicant-service.rc,
# `interface aidl android.hardware.wifi.supplicant.ISupplicant/default`).
# Dua definisi service dengan nama sama membuat yang kedua DITOLAK
# (service_parser.cpp:690-694 "ignored duplicate definition") sehingga
# interface AIDL tidak pernah terdaftar di init dan lazy start gagal:
#   init: Could not find 'aidl/android.hardware.wifi.supplicant.ISupplicant/
#   default' for ctl.interface_start  (error 0x20, log perangkat 6 Agu 2026)
# -> supplicant tidak pernah jalan -> Wi-Fi mati.

on property:ro.data.large_tcp_window_size=true
    write /proc/sys/net/ipv4/tcp_adv_win_scale  2

service ril-daemon2 /vendor/bin/hw/rild -c 2
    class main
    user radio
    group radio cache inet misc audio log readproc wakelock
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    # Alasan sama dengan vendor.ril-daemon di hardware/ril/rild/rild.rc:
    # libril-qc-qmi-1.so menuntut simbol lama yang hanya ada di libril_shim.so,
    # dan TARGET_LD_SHIM_LIBS sudah mati di 22 sehingga shim tak pernah dimuat.
    setenv LD_PRELOAD /vendor/lib/libril_shim.so

service set_baseband /vendor/bin/sh /system/vendor/bin/set_baseband.sh
    class late_start
    disabled
    user system
    group shell
    oneshot

on property:gsm.version.baseband=""
    start set_baseband

service charger /system/bin/charger
    class charger
    user system
    group system graphics input
    capabilities SYS_BOOT
    critical


#start camera server as daemon
service qcamerasvr /system/vendor/bin/mm-qcamera-daemon
    class late_start
    user camera
    group camera gps system inet input graphics
    writepid /dev/cpuset/camera-daemon/tasks
    # libmmcamera2_stats_modules.so menuntut android::SensorManager::SensorManager(),
    # konstruktor tanpa argumen yang sudah lama dicabut dari Android. libshim_camera.so
    # menyediakannya (nm: _ZN7android13SensorManagerC1Ev), tapi tidak ada yang pernah
    # memuatnya: TARGET_LD_SHIM_LIBS di BoardConfig.mk:574 SEPENUHNYA MATI di 22 --
    # tidak ada satu pun kode di vendor/lineage maupun build/make yang memprosesnya,
    # dan mekanisme LD_SHIM_LIBS tidak ada lagi di bionic/linker.
    #
    # Akibatnya mm-qcamera-daemon gagal link setiap kali dijalankan
    # ("CANNOT LINK EXECUTABLE ... cannot locate symbol"), init.svc.qcamerasvr
    # terus restarting, dan kamera tidak bisa dibuka sama sekali.
    #
    # LD_PRELOAD memuat shim sebelum blob diresolusi. Diuji langsung di perangkat
    # lewat adb sebelum ROM dibangun: tanpa LD_PRELOAD gagal link seketika,
    # dengan LD_PRELOAD daemon berjalan tanpa keluhan.
    #
    # /system/lib, bukan /system/vendor/lib: shim menaut libsensor, libandroid,
    # libstagefright, libmedia, dan libgui yang semuanya native:platform, sehingga
    # sebagai modul vendor ia ditolak build (build/make/core/binary.mk). Perangkat
    # ini memakai konfigurasi linker legacy (Treble tidak aktif) -- /system dan
    # /vendor sama-sama dir.legacy -- jadi lintas-partisi di sini sah.
    # LD_PRELOAD DIBUANG. Dulu dipakai menyuntikkan simbol sensor ke daemon,
    # dari /system/lib -- jalur yang tidak terjangkau namespace vendor:
    #   CANNOT LINK EXECUTABLE ".../mm-qcamera-daemon":
    #   library "/system/lib/libshim_camera_sensor.so" needed or dlopened by ...
    # Sekarang /vendor/lib/libandroid.so (libshims, modul libandroid_a37_vendor)
    # menyediakan ketiga belas simbol yang dibutuhkan blob SEKALIGUS konstruktor
    # android::SensorManager::SensorManager(), dan ia ditemukan lewat DT_NEEDED
    # biasa -- tanpa preload.

on property:init.svc.media=restarting
    restart qcamerasvr

on property:init.svc.servicemanager=restarting
    restart qcamerasvr

service qseecomd /system/vendor/bin/qseecomd
   class core
   user root
   group root
   writepid /dev/cpuset/system-background/tasks

# service time_daemon DIBUANG SELURUHNYA.
#
# Riwayat lengkapnya, karena mahal didapat:
#
# 1. Semula ada "seclabel u:object_r:time_daemon_exec:s0" — itu label FILE
#    (exec type), bukan domain, sehingga prosesnya berjalan dengan konteks tak
#    sah dan logcat dibanjiri denial "avc: denied { entrypoint } ... scontext=
#    u:object_r:time_daemon_exec:s0". Dihapus; init lalu memakai transisi
#    otomatis dari init_daemon_domain(time_daemon) di
#    device/qcom/sepolicy-legacy/common/time_daemon.te:7. Denial 605 -> 68.
#
# 2. Setelah itu ketahuan daemon-nya sendiri keluar status 255 tiap 5 detik:
#      E QC-time-services: Error changing gid:-1
#      E QC-time-services: Time-services exiting
#    Sebabnya baris "capabilities SYS_TIME" memangkas bounding set jadi hanya
#    CAP_SYS_TIME (capabilities.cpp:180-203 SetCapsForExec -> DropBoundingSet),
#    sehingga proses root pun kehilangan CAP_SETGID.
#
# 3. Gid tujuannya dibongkar dari .text biner (stripped, Thumb-2) dengan
#    memetakan stub PLT ke relokasi R_ARM_JUMP_SLOT lalu memindai .text per
#    2 byte untuk BL/BLX Thumb yang menuju stub itu:
#      0x1b3c  movw r0, #3004   -> setgid(AID_NET_RAW)
#      0x1b4e  mov.w r0, #1000  -> setuid(AID_SYSTEM)
#    Jadi baik root:root maupun system:system sama-sama gagal; yang benar
#    "user system" + "group net_raw system".
#
# 4. Dengan konfigurasi itu daemon-nya AKHIRNYA jalan — dan device jadi reboot
#    sendiri ke recovery sekitar semenit setelah boot. Satu-satunya perubahan
#    antara build yang stabil (20260803_140427) dan yang reboot
#    (20260803_150414) adalah baris "group" tersebut, jadi justru
#    keberhasilannya yang merusak.
#
# Kesimpulan: ATS Qualcomm ini tidak kompatibel dengan Android 11 di device
# ini. Fungsinya (sinkronisasi jam AP dengan jam modem) sudah digantikan NTP
# dan NITZ, dan ROM LineageOS 18.1 A37 yang beredar juga tidak menjalankannya
# sama sekali. mkdir /data/time di baris 80 dibiarkan — tidak berbahaya.

# ppd (mm-pp-daemon) DICABUT di 19.1 — seluruh servis dan enam trigger-nya.
#
# libmm-abl.so mereferensi android::IPowerManager::asInterface(sp<IBinder>
# const&). Android 12 mengubah IPowerManager menjadi AIDL-generated dan simbol
# C++ itu tidak ada lagi di system image, jadi linker menolak binernya SETIAP
# KALI dijalankan. Terverifikasi di perangkat: 103 kegagalan dalam 10 menit.
#
# Servisnya `disabled`, tapi dua trigger di bawah ini menghidupkannya, dan
# karena ia bukan `oneshot` init me-restart-nya selamanya tiap ~5 detik:
#     on property:init.svc.surfaceflinger=running -> start ppd
#     on property:init.svc.zygote=running         -> start ppd
#
# Konsumen satu-satunya adalah livedisplay -service-legacymm lewat socket pps.
# Servis itu ikut dicabut di device.mk, dan IPictureAdjustment dicabut dari
# manifest.xml — tanpa itu getService(true) menggantung dan Watchdog membunuh
# system_server tiap ~2 menit.

service wcnss-service /system/vendor/bin/wcnss_service
    class late_start
    user system
    group system wifi radio
    oneshot

on property:init.svc.surfaceflinger=restarting
    stop hwcomposer-2-1
    start hwcomposer-2-1

# Start it again on boot, just being double sure.
on property:sys.boot_completed=1
    start set_baseband
