//
// Disalin apa adanya dari vendor/lineage/libbfqio milik LineageOS 17.1.
// LineageOS membuangnya dari vendor/lineage setelah 17.1, tapi
// hardware/qcom-caf/msm8916/display branch lineage-19.0-caf-msm8916 masih
// memakainya: libhwcomposer/hwc_vsync.cpp:22 meng-include <bfqio/bfqio.h> dan
// baris 123 memanggil android_set_rt_ioprio(0, 1) untuk menaikkan prioritas
// I/O thread vsync. Tanpa library ini build gagal di tahap kati:
//   "hwcomposer.msm8916 ... missing libbfqio"
//
// Dibawa ke device tree, bukan dengan mem-fork tree display, supaya tree hulu
// tetap bersih — perubahannya cuma tiga berkas dan tidak ada yang perlu
// dirawat saat display bergerak.
//

cc_library_headers {
    name: "libbfqio_headers",
    vendor_available: true,
    export_include_dirs: ["include"],
}

cc_library {
    name: "libbfqio",
    vendor_available: true,
    srcs: [
        "bfqio.c",
    ],

    shared_libs: [
        "libcutils",
        "liblog",
    ],
    header_libs: [
        "libbfqio_headers",
    ],
    export_header_lib_headers: ["libbfqio_headers"],

    cflags: [
        "-Werror",
        "-Wall",
        "-Wextra",
    ],
}
